<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor.server.Application" level="INFO"/>
    <logger name="net.fortuna.ical4j" level="WARN"/>
    <logger name="dev.simplecalendar" level="${SC_LOG_LEVEL:-INFO}"/>
</configuration>
