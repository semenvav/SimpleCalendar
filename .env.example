# Copy to .env next to docker-compose.yml and edit; docker compose reads it automatically.
# .env is git-ignored: your hostname and password never reach the repository.

# --- Instance ----------------------------------------------------------------------------------
# Names this deployment. The containers, the data volume (<name>_data) and the Traefik route are
# all derived from it, so a second instance — a test one next to the family's — needs only its
# own directory, its own .env and a different name here.
COMPOSE_PROJECT_NAME=simple-calendar

# Which build to run:
#   latest        the tip of master
#   <branch>      the tip of any branch, e.g. for a test instance
#   sha-1a2b3c4   one exact commit — pin the family's instance to what you have checked
#   0.2.0         a release, for tags pushed as v0.2.0
# After changing it: docker compose pull && docker compose up -d
SC_IMAGE_TAG=latest

# --- CalDAV source -----------------------------------------------------------------------------
# Baikal's DAV root as the container sees it. If Baikal is attached to the same Docker network
# as this service, its container name works (http://baikal/dav.php/); otherwise use the hostname
# Traefik serves it under. Give a test instance its own Baikal user, or its edits will land in
# the family's calendar.
SC_CALDAV_URL=http://baikal/dav.php/
SC_CALDAV_USERNAME=family
SC_CALDAV_PASSWORD=change-me

# --- Household ---------------------------------------------------------------------------------
# Decides what "today" means and how events without a time zone are shown.
SC_TIMEZONE=Asia/Jerusalem

# How often to ask Baikal what changed. Incremental, so this is cheap.
SC_SYNC_INTERVAL_SECONDS=60

# --- Serving -----------------------------------------------------------------------------------
# Nothing is published on the host; the app is reachable only through Traefik.
SC_HOSTNAME=calendar.example.com

# The external Docker network your Traefik container is attached to.
SC_TRAEFIK_NETWORK=traefik

# Set to DEBUG to see sync and expansion timings.
SC_LOG_LEVEL=INFO

# --- Outgoing traffic --------------------------------------------------------------------------
# For a container on an internal network whose only way out is a proxy such as Squid. Every
# request the app sends follows these — Baikal's, Home Assistant's and Immich's as well as the
# weather's — with the rules curl and Go use:
#   HTTP_PROXY    for http:// addresses
#   HTTPS_PROXY   for https:// addresses, tunnelled with CONNECT; HTTP_PROXY does not cover them
#   NO_PROXY      what is reached directly, comma-separated: names (a name covers its subdomains,
#                 with or without a leading dot), IP addresses and CIDR blocks. A block matches
#                 only addresses written as numbers — a neighbour reached by its container name
#                 has to be listed by that name. localhost is always direct.
# Leave them empty to go direct. For example:
#   HTTP_PROXY=http://squid:3128
#   HTTPS_PROXY=http://squid:3128
#   NO_PROXY=localhost,127.0.0.1,172.16.0.0/12,baikal,homeassistant,immich-server
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- Integrations ------------------------------------------------------------------------------
# Each stays off until its settings are filled in; what is on shows at /api/integrations.

# Weather from Open-Meteo: free, no key. The home's coordinates, with a dot for the decimal point.
# Fetched from https://api.open-meteo.com — allow api.open-meteo.com in the proxy's whitelist.
SC_WEATHER_LATITUDE=
SC_WEATHER_LONGITUDE=

# Home Assistant: its address, a long-lived access token (your profile → Security in Home
# Assistant) and the entities to show, comma-separated, e.g.
#   SC_HA_URL=http://homeassistant:8123
#   SC_HA_ENTITIES=sensor.living_room_temperature,person.mama
SC_HA_URL=
SC_HA_TOKEN=
SC_HA_ENTITIES=

# Immich: its address, an API key (Account settings → API keys; it needs asset.read and
# asset.view) and the albums to show photos from. An album's id is the last part of its address.
#   SC_IMMICH_URL=http://immich-server:2283
SC_IMMICH_URL=
SC_IMMICH_API_KEY=
SC_IMMICH_ALBUMS=
